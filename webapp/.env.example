# CPU-loadable final detector bundle.
MODEL_ARTIFACT_PATH=../outputs/model.joblib
MODEL_DEVICE=auto

# Images must be under REAL and FAKE directories somewhere below this root.
CHALLENGE_DATASET_PATH=../data/downloads/test
# To combine multiple roots, use a comma-separated list instead of the singular setting.
# CHALLENGE_DATASET_PATHS=../data/first,../data/second
ROUND_CACHE_SIZE=500

# Development frontend. Production uses the Modal URL in .env.production.
ALLOWED_ORIGINS=http://localhost:5173
VITE_API_BASE_URL=